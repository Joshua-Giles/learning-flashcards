{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://learning-flashcards.local/schema/set.schema.json",
  "title": "Flashcard set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "category",
    "emoji",
    "tags",
    "version",
    "updated",
    "cards"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "Kebab-case, must match the file name. Never change once committed."
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 240 },
    "category": { "type": "string", "minLength": 1, "maxLength": 40 },
    "group": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "Optional sub-section within the category, e.g. a band or artist name (\"Modest Mouse\") or a language (\"Italian\"). Sets sharing a group collapse together in the sidebar."
    },
    "emoji": { "type": "string", "minLength": 1, "maxLength": 16 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 40 },
      "uniqueItems": true
    },
    "version": { "type": "integer", "minimum": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/card" }
    }
  },
  "definitions": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "answer"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 40,
          "description": "Unique within the set. Never rename or reuse — progress is keyed on it."
        },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 300 },
        "answer": { "type": "string", "minLength": 1, "maxLength": 200 },
        "accept": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 },
          "uniqueItems": true
        },
        "details": { "type": "string", "minLength": 1, "maxLength": 800 },
        "hint": { "type": "string", "minLength": 1, "maxLength": 160 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 40 },
          "uniqueItems": true
        },
        "quizzable": { "type": "boolean" }
      }
    }
  }
}
